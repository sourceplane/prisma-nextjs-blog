{
  "name": "@app/web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "scripts": {
    "dev": "prisma generate && next dev --webpack -p 3000",
    "generate": "prisma generate",
    "build": "next build --webpack && opennextjs-cloudflare build --skipBuild --skipWranglerConfigCheck && opennextjs-cloudflare populateCache local",
    "start": "next start -p 3000",
    "preview": "opennextjs-cloudflare preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "wire:fixture": "node ../../tooling/wire/render.mjs --template wrangler.template.jsonc --out wrangler.jsonc --map wiring.fixture.json --env stage",
    "db:migrate": "prisma migrate deploy",
    "db:seed": "prisma db seed"
  },
  "dependencies": {
    "@next-auth/prisma-adapter": "1.0.7",
    "@opennextjs/cloudflare": "1.20.11",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "next": "16.3.8",
    "next-auth": "4.24.15",
    "pg": "^8.23.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-markdown": "10.1.0"
  },
  "devDependencies": {
    "@app/eslint-config": "workspace:*",
    "@app/tsconfig": "workspace:*",
    "@cloudflare/workers-types": "^4.20250508.0",
    "@types/node": "^22.9.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "^17.2.3",
    "eslint": "^9.27.0",
    "eslint-config-next": "16.3.8",
    "prisma": "7.10.1",
    "tsx": "^4.20.6",
    "typescript": "^5.8.3",
    "wrangler": "^4.151.0"
  }
}
