# Local development only — the Worker never reads this file; its database is
# the HYPERDRIVE binding (wrangler.jsonc's localConnectionString locally), and
# its secrets are Worker secrets (.dev.vars under `wrangler dev`).
#
# A Postgres connection string for the Prisma CLI (`pnpm db:migrate`, which
# applies prisma/migrations; `pnpm db:seed`) and for `next dev` without
# wrangler — the Supabase CLI's database by default.
DATABASE_URL=postgres://postgres:postgres@localhost:54322/postgres

# Optional. The secret next-auth signs its cookies with: unset, the one the
# migrations generated in the database (app_private.secrets) is used.
# SECRET=

# Optional. GitHub sign-in — a GitHub OAuth App whose callback URL is
# http://localhost:3000/api/auth/callback/github. Unset, the blog runs without
# sign-in and "Log in" says how to connect it.
# GITHUB_ID=
# GITHUB_SECRET=
